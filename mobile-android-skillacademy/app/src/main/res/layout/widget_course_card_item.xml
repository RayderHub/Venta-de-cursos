<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Fila superior: Categoría y Nivel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Excel"
            android:textColor="#2DD4BF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Avanzado"
            android:textColor="#94A3B8"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Título del Curso -->
    <TextView
        android:id="@+id/widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Excel Avanzado: Fórmulas y Dashboards"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Instructor -->
    <TextView
        android:id="@+id/widget_item_instructor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Prof. Laura Gómez"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <!-- Barra de progreso compacta -->
    <ProgressBar
        android:id="@+id/widget_item_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <!-- Pie de la tarjeta: porcentaje y botón continuar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_item_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="65% completado"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Continuar"
            android:textColor="#5EEAD4"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
