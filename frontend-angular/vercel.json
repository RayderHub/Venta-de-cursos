{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/frontend-angular/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://skillacademy-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
